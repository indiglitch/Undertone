{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Undertone",
  "version": "0.2.3",
  "identifier": "local.undertone.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Undertone \u2014 \u0432\u0430\u0448\u0430 \u043c\u0443\u0437\u044b\u043a\u0430",
        "width": 1440,
        "height": 940,
        "minWidth": 1000,
        "minHeight": 700,
        "backgroundColor": "#111210",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../third-party/THIRD_PARTY_NOTICES.md": "third-party/THIRD_PARTY_NOTICES.md",
      "../third-party/MPL-SOURCE-ACCESS.md": "third-party/MPL-SOURCE-ACCESS.md",
      "../third-party/MPL-2.0.txt": "third-party/MPL-2.0.txt",
      "../third-party/MPL-MODIFICATIONS/symphonia-bundle-mp3-0.5.5/synthesis.rs": "third-party/MPL-MODIFICATIONS/symphonia-bundle-mp3-0.5.5/synthesis.rs",
      "../third-party/dependencies.spdx.json": "third-party/dependencies.spdx.json"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczQkNGNTkxRDlCNUJGMEUKUldRT3Y3WFprZlc4YzdsUm1jL2IybU9YRFAxdklkc2tCZUI1b0tQalNDMy92QlhRZ2oxbXAvcUgK",
      "endpoints": [
        "https://github.com/indiglitch/Undertone/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
