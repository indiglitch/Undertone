    "test:navigation": "node --test --experimental-strip-types src/navigationModel.test.ts",
    "test:playback": "node --test --experimental-strip-types src/playbackModes.test.ts",
    "test:track-context-menu": "node --test --experimental-strip-types src/trackContextMenuModel.test.ts",
    "test:lyrics-indexing": "node --test --experimental-strip-types src/bulkLyricsModel.test.ts",
    "test:lyrics-view": "node --test --experimental-strip-types src/lyricsViewModel.test.ts",
    "test:phase3d2": "node --test --experimental-strip-types src/phase3d2Model.test.ts",
    "test:deleted-songs": "node --test --experimental-strip-types src/deletedSongsModel.test.ts",
    "test:resizable-layout": "node --test --experimental-strip-types src/resizableLayoutModel.test.ts",
    "test:playback-session": "node --test --experimental-strip-types src/playbackSessionModel.test.ts",
    "test:player-responsive": "node --test --experimental-strip-types src/playerResponsive.test.ts",
    "test:visualizer": "node --test --experimental-strip-types src/musicVisualizer.test.ts",
    "test:player-layout": "node --test --experimental-strip-types src/playerLayout.test.ts",
